@InProceedings{Guex2015,
    doi       = {10.1007/978-3-662-44983-7_9},
    author    = {Guex, Guillaume and Bavaud, Fran{\c{c}}ois},
    booktitle = {Data Science, Learning by Latent Structures, and Knowledge Discovery},
    title     = {Flow-Based Dissimilarities: Shortest Path, Commute Time, Max-Flow and Free Energy},
    year      = {2015},
    address   = {Berlin, Heidelberg},
    editor    = {Lausen, Berthold and Krolak-Schwerdt, Sabine and B{\"o}hmer, Matthias},
    pages     = {101--111},
    publisher = {Springer Berlin Heidelberg},
    abstract  = {Random-walk based dissimilarities on weighted networks have demonstrated their efficiency in clustering algorithms. This contribution considers a few alternative network dissimilarities, among which a new max-flow dissimilarity, and more general flow-based dissimilarities, freely mixing shortest paths and random walks in function of a free parameter---the temperature. Their geometrical properties and in particular their squared Euclidean nature are investigated through their power indices and multidimensional scaling properties. In particular, formal and numerical studies demonstrate the existence of critical temperatures, where flow-based dissimilarities cease to be squared Euclidean. The clustering potential of medium range temperatures is emphasized.},
    isbn      = {978-3-662-44983-7}
},

